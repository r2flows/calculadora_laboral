# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# En producción (Railway) estas mismas variables se configuran en el servicio.
# Ojo: las NEXT_PUBLIC_* se incrustan al compilar; si cambian hay que redeployar.

# ─── MODO ADMINISTRADOR ───────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_CODE=TU_CODIGO_AQUI

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─── IA / EXTRACCIÓN DOCUMENTOS ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── EMAIL (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=portal@laboral.agentloop.cl

# ─── URL PÚBLICA ──────────────────────────────────────────────────────────────
# Links de email y llamadas internas. En Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
# Si se omite, se usa RAILWAY_PUBLIC_DOMAIN y luego http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
